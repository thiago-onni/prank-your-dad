{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sus-nexus.gov.br/events/identity/citizen/1.0.0",
  "title": "sus.identity.citizen.* — data",
  "description": "Payload (campo data) dos eventos do tópico sus.identity.citizen.v1. Sem CPF/CNS em claro.",
  "type": "object",
  "additionalProperties": false,
  "required": ["municipal_citizen_id", "registration_state", "action"],
  "properties": {
    "action": { "type": "string", "enum": ["created", "linked", "updated", "registration_state_changed"] },
    "municipal_citizen_id": { "type": "string", "pattern": "^cit_[0-9A-HJKMNP-TV-Z]{26}$" },
    "registration_state": { "type": "string", "enum": ["validated", "divergent", "incomplete", "duplicate", "pending"] },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "classification"],
      "properties": {
        "method": { "type": "string", "enum": ["deterministic_cns", "deterministic_cpf", "deterministic_source_link", "deterministic_demographics", "probabilistic", "manual", "none"] },
        "classification": { "type": "string", "enum": ["confirmed", "probable", "pending", "rejected", "new"] },
        "score": { "type": "number" },
        "rule_version": { "type": "string" }
      }
    },
    "linked_identifier_systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changed_attributes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health_unit_cnes": { "type": "string", "pattern": "^[0-9]{7}$" },
        "team_ine": { "type": "string" },
        "microarea": { "type": "string" }
      }
    }
  }
}
