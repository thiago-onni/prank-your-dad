{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sus-nexus.gov.br/events/integration/status/1.0.0",
  "title": "sus.integration.status.* — data",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "connector_id", "connector_version"],
  "properties": {
    "action": { "type": "string", "enum": ["healthy", "degraded", "down", "reconciliation_gap"] },
    "connector_id": { "type": "string" },
    "connector_version": { "type": "string" },
    "source_system": { "type": "string" },
    "detail": { "type": "string", "maxLength": 1000 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "received_total": { "type": "integer", "minimum": 0 },
        "processed_total": { "type": "integer", "minimum": 0 },
        "failed_total": { "type": "integer", "minimum": 0 },
        "latency_p95_ms": { "type": "number", "minimum": 0 },
        "reconciliation_gap": { "type": "integer" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    }
  }
}
