# --- Autenticação (BFF) ---
# mock | keycloak
AUTH_MODE=mock
AUTH_SECRET=troque-por-um-segredo-de-32-bytes
AUTH_URL=http://localhost:3000
# Keycloak (AUTH_MODE=keycloak)
AUTH_KEYCLOAK_ID=sus-nexus-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/sus-nexus
# Usuário fake (AUTH_MODE=mock)
AUTH_MOCK_USER=Maria Operadora (mock)
AUTH_MOCK_EMAIL=maria.operadora@saude.exemplo.gov.br
AUTH_MOCK_ROLES=cadastrador,operador_integracao,enfermagem,gestor
AUTH_MOCK_MUNICIPALITY=ibge_3143302
# Lotação do usuário fake (claims cnes/teams/microareas): só define filtros padrão na UI.
# Ex.: ACS → AUTH_MOCK_ROLES=acs e AUTH_MOCK_MICROAREAS=01,02 ; hospital → AUTH_MOCK_ROLES=profissional_hospitalar
AUTH_MOCK_CNES=2126672
AUTH_MOCK_TEAMS=
AUTH_MOCK_MICROAREAS=

# --- Core Municipal ---
CORE_API_URL=http://localhost:8080
# true: MSW responde no servidor (sem backend)
NEXT_PUBLIC_API_MOCK=true

# --- AI Service (agentes) ---
# Base do ai-service (FastAPI). O navegador usa o proxy BFF /api/ai; com NEXT_PUBLIC_API_MOCK=true o MSW responde.
AI_SERVICE_URL=http://localhost:8090
