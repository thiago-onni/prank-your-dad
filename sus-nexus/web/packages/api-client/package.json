{
  "name": "@sus-nexus/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente tipado da Core Municipal API (openapi-typescript + openapi-fetch) e hooks TanStack Query",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/core.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../contracts/openapi/core-municipal.yaml -o src/generated/core.d.ts --alphabetize --empty-objects-unknown",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "openapi-fetch": "0.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "3.2.7"
  }
}
