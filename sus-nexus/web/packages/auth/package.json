{
  "name": "@sus-nexus/auth",
  "version": "0.1.0",
  "private": true,
  "description": "BFF OIDC (Auth.js v5 + Keycloak) para Next.js: sessão em cookie httpOnly, refresh no servidor, token nunca chega ao navegador; modo mock para desenvolvimento",
