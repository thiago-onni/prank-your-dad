    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "next-auth": "5.0.0-beta.32"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "3.2.7"
  }
