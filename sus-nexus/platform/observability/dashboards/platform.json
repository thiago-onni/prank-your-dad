    {
      "id": 9,
      "title": "Error budget restante (MPI, 30d, SLO 99.5%)",
      "type": "gauge",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((1 - (sum(rate(http_server_requests_seconds_count{service=\"core-municipal\",uri=~\"/api/v1/(citizens|mpi).*\",status!~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count{service=\"core-municipal\",uri=~\"/api/v1/(citizens|mpi).*\"}[30d])))) / (1 - 0.995))",
          "legendFormat": "budget",
          "refId": "I"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
