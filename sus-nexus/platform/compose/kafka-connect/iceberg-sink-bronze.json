{
  "name": "bronze-iceberg-sink",
  "_comment": "Kafka Connect Iceberg sink: tópicos de domínio sus.* (exceto sus.ingest.*, sus.dlq.v1, sus.audit.v1) → tabelas bronze.events_<domínio> (Iceberg, catálogo JDBC no PostgreSQL, dados no MinIO bucket lakehouse). Roteamento por event_type (sus.<domínio>.*). Tabelas criadas antes por platform/compose/trino/bronze-ddl.sql (partição tenant.municipality_id + day(occurred_at)). Mantenha em sincronia com platform/helm/sus-nexus/templates/lakehouse.yaml.",
  "config": {
    "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
    "tasks.max": "${ICEBERG_SINK_TASKS}",
    "topics.regex": "^sus\\.(?!ingest\\.|dlq\\.|audit\\.)[a-z][a-z-]*(\\.[a-z][a-z-]*)?\\.v[0-9]+$",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
    "consumer.override.auto.offset.reset": "earliest",
    "transforms": "kafkaMetadata",
    "transforms.kafkaMetadata.type": "org.apache.iceberg.connect.transforms.KafkaMetadataTransform",
    "iceberg.tables": "bronze.events_identity,bronze.events_aps,bronze.events_schedule,bronze.events_regulation,bronze.events_exam,bronze.events_hospital,bronze.events_careplan,bronze.events_caregap,bronze.events_task,bronze.events_production,bronze.events_communication,bronze.events_consent,bronze.events_integration",
    "iceberg.tables.route-field": "event_type",
    "iceberg.table.bronze.events_identity.route-regex": "sus\\.identity\\..+",
    "iceberg.table.bronze.events_aps.route-regex": "sus\\.aps\\..+",
    "iceberg.table.bronze.events_schedule.route-regex": "sus\\.schedule\\..+",
    "iceberg.table.bronze.events_regulation.route-regex": "sus\\.regulation\\..+",
    "iceberg.table.bronze.events_exam.route-regex": "sus\\.exam\\..+",
    "iceberg.table.bronze.events_hospital.route-regex": "sus\\.hospital\\..+",
    "iceberg.table.bronze.events_careplan.route-regex": "sus\\.careplan\\..+",
    "iceberg.table.bronze.events_caregap.route-regex": "sus\\.caregap\\..+",
    "iceberg.table.bronze.events_task.route-regex": "sus\\.task\\..+",
    "iceberg.table.bronze.events_production.route-regex": "sus\\.production\\..+",
    "iceberg.table.bronze.events_communication.route-regex": "sus\\.communication\\..+",
    "iceberg.table.bronze.events_consent.route-regex": "sus\\.consent\\..+",
    "iceberg.table.bronze.events_integration.route-regex": "sus\\.integration\\..+",
    "iceberg.tables.dynamic-enabled": "false",
    "iceberg.tables.auto-create-enabled": "false",
    "iceberg.tables.evolve-schema-enabled": "false",
    "iceberg.tables.schema-case-insensitive": "true",
    "iceberg.control.topic": "_connect.iceberg-control",
    "iceberg.control.commit.interval-ms": "${ICEBERG_COMMIT_INTERVAL_MS}",
    "iceberg.coordinator.transactional.prefix": "iceberg-bronze-",
    "iceberg.catalog": "iceberg",
    "iceberg.catalog.catalog-impl": "org.apache.iceberg.jdbc.JdbcCatalog",
    "iceberg.catalog.uri": "jdbc:postgresql://${CATALOG_DB_HOST}:${CATALOG_DB_PORT}/${CATALOG_DB_NAME}",
    "iceberg.catalog.jdbc.user": "${CATALOG_DB_USER}",
    "iceberg.catalog.jdbc.password": "${CATALOG_DB_PASSWORD}",
    "iceberg.catalog.jdbc.schema-version": "V1",
    "iceberg.catalog.warehouse": "s3://${LAKEHOUSE_BUCKET}/warehouse",
    "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
    "iceberg.catalog.s3.endpoint": "${S3_ENDPOINT}",
    "iceberg.catalog.s3.path-style-access": "true",
    "iceberg.catalog.s3.access-key-id": "${S3_ACCESS_KEY}",
    "iceberg.catalog.s3.secret-access-key": "${S3_SECRET_KEY}",
    "iceberg.catalog.client.region": "us-east-1",
    "iceberg.tables.write-props.write.format.default": "parquet",
    "iceberg.tables.write-props.write.parquet.compression-codec": "zstd",
    "errors.tolerance": "all",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false",
    "errors.deadletterqueue.topic.name": "sus.dlq.v1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.deadletterqueue.topic.replication.factor": "${DLQ_REPLICATION_FACTOR}"
  }
}
